{
  "name": "vite-first",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "stats": "tsx src/util/stats-cli.ts",
    "lint": "eslint src",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:real-timer": "playwright test tests/e2e/real-timer.spec.ts",
    "check": "npm run check:types && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@vitest/coverage-v8": "^4.1.10",
    "daisyui": "^5.7.14",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.25",
    "postcss-cli": "^11.0.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dexie": "^4.4.4",
    "katex": "^0.18.1",
    "simple-statistics": "^7.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.0": true
  }
}
