{
  "name": "vite-first",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "stats": "tsx src/util/stats-cli.ts",
    "lint": "eslint src",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
